        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "FIELD",
          "name": "language",
          "content": {
            "type": "SYMBOL",
            "name": "code_language"
          }
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
