          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "math_content": {
      "type": "PATTERN",
      "value": "([^{}\\r\\n]|\\{[^}]*\\}|\\r?\\n)+"
    },
    "_inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "SYMBOL",
          "name": "emph"
        },
        {
          "type": "SYMBOL",
          "name": "inline_code"
        },
        {
          "type": "SYMBOL",
          "name": "ref"
        },
        {
          "type": "SYMBOL",
          "name": "ref_with_text"
        },
        {
          "type": "SYMBOL",
          "name": "link"
        },
        {
          "type": "SYMBOL",
          "name": "math_inline"
        },
        {
          "type": "SYMBOL",
          "name": "tagged_ul"
        },
        {
          "type": "SYMBOL",
          "name": "tagged_ol"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s{}\\[\\]]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [
    [
