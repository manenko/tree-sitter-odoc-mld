      }
    },
    "heading_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_inline"
      }
    },
    "code_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
