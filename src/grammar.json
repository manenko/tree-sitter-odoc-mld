          "name": "indexlist_directive"
        },
        {
          "type": "SYMBOL",
          "name": "tag"
        },
        {
          "type": "SYMBOL",
          "name": "paragraph"
        }
      ]
    },
    "paragraph": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "_inline"
        }
      }
    },
    "heading": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "FIELD",
          "name": "level",
          "content": {
            "type": "SYMBOL",
            "name": "heading_level"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "label",
              "content": {
                "type": "SYMBOL",
                "name": "heading_label"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "SYMBOL",
            "name": "heading_content"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "heading_level": {
      "type": "PATTERN",
      "value": "[0-4]"
    },
    "heading_label": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": ":[a-zA-Z0-9_-]+"
