{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "odoc_mld",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_block_line"
      }
    },
    "_block_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_block"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_block": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "heading"
        },
        {
          "type": "SYMBOL",
          "name": "code_block"
        },
        {
          "type": "SYMBOL",
          "name": "tagged_code_block"
        },
        {
          "type": "SYMBOL",
          "name": "verbatim_block"
        },
        {
          "type": "SYMBOL",
          "name": "math_block"
        },
        {
          "type": "SYMBOL",
          "name": "ul_item"
        },
        {
          "type": "SYMBOL",
          "name": "ol_item"
        },
        {
          "type": "SYMBOL",
          "name": "modules_directive"
        },
        {
