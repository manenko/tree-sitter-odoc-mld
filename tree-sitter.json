{
  "grammars": [
    {
      "name": "odoc-mld",
      "camelcase": "OdocMld",
      "scope": "source.odoc_mld",
      "path": ".",
      "file-types": [
        "mld"
      ],
      "highlights": "runtime/queries/odoc-mld/highlights.scm",
      "injections": "runtime/queries/odoc-mld/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for OCaml odoc .mld files",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-odoc-mld"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
